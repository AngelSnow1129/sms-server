# Server
SERVER_ADDR=:53340

# DB backend driver: mysql (default) or sqlite
# mysql  -> connect MySQL (MYSQL_DSN), GORM AutoMigrate; OTP codes kept in memory
# sqlite -> no MySQL at all; OTP codes persisted in SQLITE_PATH (table otps).
#           NOTE: SMS records are NOT persisted in this mode (repo is MySQL-only)
DB_DRIVER=mysql

# MySQL DSN: user:password@tcp(host:port)/dbname?parseTime=true&loc=Local
# Used only when DB_DRIVER=mysql
MYSQL_DSN=user:password@tcp(127.0.0.1:3306)/smsdb?parseTime=true&loc=Local

# SQLite file path, used only when DB_DRIVER=sqlite (default: ./sms.db)
# Holds the `otps` table: codes survive restarts, and read codes are soft-deleted
# (status='read') and kept for 10 minutes for reconciliation before physical cleanup.
SQLITE_PATH=./sms.db

# HMAC secret for phone token generation (REQUIRED, min 16 chars)
HMAC_SECRET=your-secret-key-here-change-in-production

# Webhook secret for SMS webhook authentication (REQUIRED, min 16 chars)
WEBHOOK_SECRET=your-webhook-secret-here-change-in-production

# OTP cache TTL in minutes (default: 5)
OTP_CACHE_TTL_MINUTES=5

# Cleanup interval in seconds (default: 30)
CLEANUP_INTERVAL_SECONDS=30

